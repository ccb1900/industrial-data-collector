{
  "collector-console": [
    {
      "ID": "ui-page-overview",
      "Type": "ui-page",
      "Config": {
        "actions": [
          {
            "command": "trigger",
            "datePicker": true,
            "label": "立即采集"
          }
        ],
        "description": "哪里需要处理，一眼可见：异常置顶，健康的历史不放前台。",
        "icon": "dashboard",
        "order": 0,
        "page_id": "overview",
        "renderer": "views",
        "route": "/overview",
        "title": "概览",
        "views": [
          {
            "items": [
              {
                "label": "数据源",
                "op": "count",
                "query": "sources"
              },
              {
                "filter": {
                  "in": [
                    "Failed",
                    "Pending"
                  ],
                  "key": "status"
                },
                "label": "待处理",
                "op": "count",
                "query": "collections",
                "warn": true
              },
              {
                "field": "records",
                "label": "累计记录",
                "op": "sum",
                "query": "collections"
              },
              {
                "field": "filesFailed",
                "label": "失败文件",
                "op": "sum",
                "query": "collections",
                "warn": true
              }
            ],
            "kind": "stats"
          },
          {
            "columns": [
              {
                "key": "sourceId",
                "title": "数据源"
              },
              {
                "key": "date",
                "title": "采集日期"
              },
              {
                "key": "status",
                "title": "状态"
              },
              {
                "key": "note",
                "title": "原因"
              }
            ],
            "filter": {
              "in": [
                "Failed",
                "Pending"
              ],
              "key": "status"
            },
            "kind": "table",
            "pageSize": 8,
            "query": "collections",
            "title": "需要处理（失败 / 等待数据）"
          },
          {
            "dateKey": "date",
            "kind": "trend",
            "query": "collections",
            "series": [
              {
                "key": "records",
                "label": "采集"
              },
              {
                "key": "filesFailed",
                "label": "失败"
              }
            ],
            "title": "按日采集量"
          }
        ]
      },
      "Enabled": null
    },
    {
      "ID": "ui-page-collect",
      "Type": "ui-page",
      "Config": {
        "description": "以源为中心的运营台：选源 → 日历选日期 → 当日任务、文件、失败与数据样本都在这一屏。",
        "icon": "profile",
        "order": 10,
        "page_id": "collect",
        "renderer": "views",
        "route": "/collect",
        "title": "采集",
        "views": [
          {
            "fields": [
              {
                "key": "schedule",
                "label": "调度策略"
              },
              {
                "key": "cron",
                "label": "Cron 表达式"
              },
              {
                "key": "next",
                "label": "下次触发"
              }
            ],
            "kind": "kv",
            "query": "schedule",
            "title": "调度"
          },
          {
            "columns": [
              {
                "key": "name",
                "title": "数据源"
              },
              {
                "key": "status",
                "title": "状态"
              }
            ],
            "detailViews": [
              {
                "kind": "calendar",
                "query": "collections",
                "title": "采集状态日历"
              },
              {
                "fields": [
                  {
                    "key": "status",
                    "label": "状态"
                  },
                  {
                    "key": "records",
                    "label": "记录数"
                  },
                  {
                    "key": "filesCompleted",
                    "label": "完成文件"
                  },
                  {
                    "key": "filesFailed",
                    "label": "失败文件"
                  }
                ],
                "kind": "kv",
                "params": {
                  "date": "$focus.date",
                  "sourceId": "$focus.sourceId"
                },
                "query": "collection",
                "title": "当日采集详情"
              },
              {
                "columns": [
                  {
                    "key": "name",
                    "title": "文件"
                  },
                  {
                    "key": "records",
                    "title": "记录数"
                  },
                  {
                    "key": "status",
                    "title": "状态"
                  }
                ],
                "expand": "metadata",
                "kind": "table",
                "pageSize": 10,
                "params": {
                  "date": "$focus.date",
                  "sourceId": "$focus.sourceId"
                },
                "query": "files",
                "title": "当日文件明细"
              },
              {
                "columns": [
                  {
                    "key": "date",
                    "title": "采集日"
                  },
                  {
                    "key": "name",
                    "title": "文件"
                  },
                  {
                    "key": "attempts",
                    "title": "次数"
                  },
                  {
                    "key": "error",
                    "title": "错误"
                  }
                ],
                "kind": "table",
                "pageSize": 5,
                "params": {
                  "sourceId": "$focus.sourceId"
                },
                "query": "failures",
                "title": "该源失败账本"
              },
              {
                "kind": "table",
                "pageSize": 5,
                "params": {
                  "limit": "5",
                  "sourceId": "$focus.sourceId"
                },
                "query": "rows",
                "title": "数据样本（按采集顺序）"
              }
            ],
            "focusKey": "id",
            "kind": "master-detail",
            "pageSize": 30,
            "query": "sources",
            "rowActions": [
              {
                "args": {
                  "sourceId": "$row.id"
                },
                "command": "trigger",
                "label": "采集"
              }
            ]
          }
        ]
      },
      "Enabled": null
    },
    {
      "ID": "ui-page-data",
      "Type": "ui-page",
      "Config": {
        "description": "类型化入库数据的分页查询：列由响应自适应，换存储换业务无需改页面。",
        "icon": "search",
        "order": 20,
        "page_id": "data",
        "renderer": "views",
        "route": "/data",
        "title": "数据",
        "views": [
          {
            "filters": [
              {
                "key": "sourceId",
                "label": "数据源",
                "optionKey": "id",
                "optionLabel": "name",
                "optionsQuery": "sources",
                "required": true
              },
              {
                "default": "$yesterday",
                "key": "date",
                "label": "日期",
                "type": "date"
              }
            ],
            "kind": "query-table",
            "pageSize": 20,
            "query": "rows",
            "title": "记录查询"
          },
          {
            "kind": "kv",
            "query": "storage",
            "title": "存储洞察"
          }
        ]
      },
      "Enabled": null
    },
    {
      "ID": "ui-panel-logs",
      "Type": "ui-panel",
      "Config": {
        "order": 25,
        "pages": [
          "overview"
        ],
        "panel_id": "logs",
        "position": "bottom",
        "renderer": "views",
        "title": "日志",
        "views": [
          {
            "columns": [
              {
                "key": "time",
                "title": "时间"
              },
              {
                "key": "level",
                "title": "级别"
              },
              {
                "key": "msg",
                "title": "消息"
              }
            ],
            "kind": "table",
            "pageSize": 8,
            "params": {
              "limit": "100"
            },
            "query": "logs"
          }
        ]
      },
      "Enabled": null
    },
    {
      "ID": "ui-panel-event-feed",
      "Type": "ui-panel",
      "Config": {
        "order": 20,
        "pages": [
          "overview"
        ],
        "panel_id": "event-feed",
        "position": "bottom",
        "renderer": "event-feed",
        "title": "事件流"
      },
      "Enabled": null
    }
  ],
  "collector-core": [
    {
      "ID": "console-bridge",
      "Type": "console-bridge",
      "Config": null,
      "Enabled": null
    },
    {
      "ID": "console-rows",
      "Type": "console-rows",
      "Config": null,
      "Enabled": null
    },
    {
      "ID": "query-provider",
      "Type": "query-provider",
      "Config": null,
      "Enabled": null
    },
    {
      "ID": "ui",
      "Type": "ui",
      "Config": null,
      "Enabled": null
    },
    {
      "ID": "plugin-explorer",
      "Type": "plugin-explorer",
      "Config": {
        "icon": "block",
        "order": 40,
        "page_id": "plugins",
        "route": "/plugins",
        "title": "插件"
      },
      "Enabled": null
    }
  ]
}
