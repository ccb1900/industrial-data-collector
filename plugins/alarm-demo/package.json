{
  "name": "@gocordis-demo/alarm-demo",
  "version": "0.1.0",
  "private": true,
  "description": "报警监控示例插件：完全自定义控制台页面，自带 ECharts",
  "type": "module",
  "cordis": {
    "client": "./ui.js",
    "renderer": "alarm-console"
  },
  "scripts": {
    "build": "esbuild src/ui.tsx --bundle --format=esm --minify --jsx=automatic --alias:react=./shims/react.js --alias:react/jsx-runtime=./shims/react-jsx-runtime.js --alias:antd=./shims/antd.js --outfile=ui.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "echarts": "^5.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "@types/react": "^18.3.0"
  }
}