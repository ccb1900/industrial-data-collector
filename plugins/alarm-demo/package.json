    "build": "esbuild src/ui.js --bundle --format=esm --minify --outfile=ui.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "echarts": "^5.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
