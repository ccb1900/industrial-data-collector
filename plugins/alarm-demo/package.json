{
  "name": "@gocordis-demo/alarm-demo",
  "version": "0.1.0",
  "private": true,
  "description": "报警监控示例插件：完全自定义控制台页面，自带 ECharts",
  "type": "module",
  "cordis": {
    "client": "./ui.js",
    "renderer": "alarm-console"
  },
